# .env.example
# Copy this to .env and fill in your values

# ==================== API Keys ====================
# Federal Reserve Economic Data (FRED)
# Get free key at: https://fredaccount.stlouisfed.org/account/api
FRED_API_KEY=your_fred_api_key_here

# ==================== Cache Configuration ====================
# Custom cache directory (optional)
# Linux/macOS default: ~/.cache/arbs/zodb/dump
# Windows default: %LOCALAPPDATA%\ARBS\zodb\dump
ARBS_CACHE_ROOT=${HOME}/.cache/arbs

# Force refresh cache on startup (true/false)
ARBS_FORCE_REFRESH_FIXINGS=false

# Use B-tree indexing for caches (faster for large caches)
ARBS_USE_BTREE=true

# ==================== Data Sources ====================
# Primary data source
# Options: CME_NY_EOD_LIVE-ql_basic, SDR_INTRADAY-RL, GSQUANT-RL
CME_SOURCE=CME_NY_EOD_LIVE-ql_basic

# SDR data directory (if using SDR data)
SDR_DATA_DIR=./data/sdr

# ==================== Network (Proxy) ====================
# Set if behind corporate firewall
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080

# ==================== Development Settings ====================
# Enable debug mode (true/false)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==================== Database ====================
# ZODB cache maximum size in GB
ARBS_CACHE_MAX_SIZE_GB=100

# ZODB pack interval in days (0 = never)
ARBS_CACHE_PACK_INTERVAL_DAYS=7
