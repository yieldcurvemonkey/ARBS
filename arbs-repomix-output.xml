import asyncio
import logging
import warnings
from datetime import datetime, timedelta
from functools import reduce
from io import StringIO
from typing import Annotated, Dict, List, Literal, Optional, Tuple
from urllib.parse import quote, unquote, urlencode

import httpx
import pandas as pd
import requests
import tqdm
