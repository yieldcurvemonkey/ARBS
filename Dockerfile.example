# Dockerfile.example
# Build production ARBS container
# Usage: docker build -f Dockerfile.example -t arbs:latest .

FROM python:3.13-slim

LABEL maintainer="ARBS Team"
LABEL description="Awesome Rates Backtesting System (ARBS) Docker image"

WORKDIR /opt/arbs

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libboost-all-dev \
    libboost-python-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements files
COPY requirements.txt requirements-prod.txt ./

# Upgrade pip and install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements-prod.txt

# Copy application code
COPY . .

# Create non-root user
RUN useradd -m -u 1000 arbs && \
    chown -R arbs:arbs /opt/arbs

# Create cache and log directories
RUN mkdir -p /mnt/arbs_cache /var/log/arbs && \
    chown -R arbs:arbs /mnt/arbs_cache /var/log/arbs

# Switch to non-root user
USER arbs

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/opt/arbs:$PYTHONPATH"
ENV ARBS_CACHE_ROOT="/mnt/arbs_cache"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "from MDP.IRSwaps.IRSwapsMDP import IRSwapsMDP; IRSwapsMDP()" || exit 1

# Default command
CMD ["python", "-u", "scripts/production_backtest.py"]

