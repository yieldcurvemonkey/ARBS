# Per-route LRU bound for analytics-dock routes
# (analytics-timeseries, rarity, extremes). Defaults to 512.
# 512 ~ 75 MB worst case at rarity payload size; safe for ~3 users.
ANALYTICS_LRU_MAX=512

# Max entries persisted in the IndexedDB-backed SWR cache (client).
# Defaults to 200; ~30 MB worst case across all three analytics routes.
NEXT_PUBLIC_SWR_CACHE_MAX_ENTRIES=200

# Enable analytics-dock prefetch on row hover (150 ms debounce).
# Defaults to on; set to "false" for emergency rollback without
# redeploying.
NEXT_PUBLIC_ENABLE_HOVER_PREFETCH=true

# Shared secret gating manual tape overrides (GROUP/SPLIT/DETACH create/edit/delete).
# Unset or blank => all override write endpoints are locked (403). Notes need no password.
TAPE_OVERRIDE_PASSWORD=
